// FL_CRM demo schema — subset of the full-build schema (same entity and column names).
// Money: Decimal(12,2). Calendar dates (@db.Date) are IST business dates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity ─────────────────────────

enum Role {
  SuperAdmin
  Admin
  User
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  dayCloseGraceDays Int      @default(3) // a day can be closed this many days later; after that only the Super Admin
  createdAt         DateTime @default(now())
  users             User[]
}

// Better Auth user + FL_CRM fields
model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  role            Role      @default(User)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  active          Boolean   @default(true)
  deletedAt       DateTime? // Settings → Users "Delete": login removed, work handed over; the name stays on old records
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions     Session[]
  authAccounts AuthAccount[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Better Auth "account" (credentials) — renamed so it doesn't clash with money Account
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Sales ─────────────────────────

/**
 * Business type (how the lead came in).
 */
enum LeadSource {
  Direct
  WalkIn
  Referral // referrerName required
  Website
  SocialMedia
}

enum LeadStatus {
  Interested
  NotInterested // reason required; closes the lead
  CallBack // a call is booked
}

/**
 * Moved by the system: quotation made → Quotation, proposal → Proposal, policy number → Customer.
 */
enum LeadStage {
  Lead
  Quotation
  Proposal
  Customer
}

enum Gender {
  Female
  Male
  Other
}

model Lead {
  id                  String     @id @default(cuid())
  tenantId            String
  leadNo              String
  name                String // full name (first + last), used everywhere a lead is shown
  firstName           String
  lastName            String?
  gender              Gender? // required for new leads; older leads may not have it
  mobile              String // first number; all numbers are in `mobiles`
  email               String?
  dob                 DateTime?  @db.Date
  address             String?
  onWhatsApp          Boolean    @default(false) // the first number uses WhatsApp
  source              LeadSource
  referrerName        String?
  status              LeadStatus @default(CallBack)
  stage               LeadStage  @default(Lead)
  interest            String? // interested product
  notes               String?
  notInterestedReason String?
  ownerId             String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  mobiles    LeadMobile[]
  calls      Call[]
  quotations Quotation[]

  @@unique([tenantId, leadNo])
  @@unique([tenantId, mobile])
}

/**
 * Every mobile number of a lead; a number belongs to one lead only (duplicate check).
 */
model LeadMobile {
  id         String  @id @default(cuid())
  tenantId   String
  leadId     String
  lead       Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  number     String
  isWhatsApp Boolean @default(false)
  sort       Int     @default(0)

  @@unique([tenantId, number])
  @@index([leadId])
}

enum CallOutcome {
  Interested
  NoAnswer // call back: next call booked
  NotInterested
  Done // renewal / proposal call finished, no next call
}

/**
 * A follow-up call about a lead, a renewal (policy) or a proposal.
 */
model Call {
  id          String       @id @default(cuid())
  tenantId    String
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id])
  policyId    String?
  policy      Policy?      @relation(fields: [policyId], references: [id])
  proposalId  String?
  proposal    Proposal?    @relation(fields: [proposalId], references: [id])
  customerId  String? // a general follow-up on a customer (not about one renewal or proposal)
  customer    Customer?    @relation(fields: [customerId], references: [id])
  ownerId     String
  dueAt       DateTime
  note        String?
  outcome     CallOutcome?
  outcomeNote String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([ownerId, outcome, dueAt])
}

enum QuotationStatus {
  Draft
  Accepted // proposals made from the selected products
  NotAccepted
}

/**
 * The customer's decision on each quoted product.
 */
enum QuoteItemDecision {
  Pending
  Selected
  NotAccepted
}

model Quotation {
  id           String          @id @default(cuid())
  tenantId     String
  quoteNo      String
  leadId       String?
  lead         Lead?           @relation(fields: [leadId], references: [id])
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  customerName String
  mobile       String
  status       QuotationStatus @default(Draft)
  validUpto    DateTime        @db.Date
  subtotal     Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  ownerId      String
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())

  notAcceptedReason String?
  deletedAt         DateTime? // deleted (only while no proposal exists); kept for the change log
  deletedById       String?
  deleteReason      String?

  items     QuotationItem[]
  proposals Proposal[]

  @@unique([tenantId, quoteNo])
}

model QuotationItem {
  id          String            @id @default(cuid())
  quotationId String
  quotation   Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category    String // Health, Life, Motor, …
  insurer     String
  productName String
  sumInsured  Decimal?          @db.Decimal(14, 2)
  premium     Decimal           @db.Decimal(12, 2)
  total       Decimal           @db.Decimal(12, 2)
  payMode     Frequency         @default(Yearly)
  decision    QuoteItemDecision @default(Pending)
  proposal    Proposal?
}

enum ProposalStatus {
  Draft
  ConsentPending
  ConsentGiven
  Issued
}

model Proposal {
  id                      String         @id @default(cuid())
  tenantId                String
  proposalNo              String
  quotationId             String? // null = added directly on a customer (no quotation)
  quotation               Quotation?     @relation(fields: [quotationId], references: [id])
  quotationItemId         String?        @unique // one proposal per quoted product
  quotationItem           QuotationItem? @relation(fields: [quotationItemId], references: [id])
  customerId              String?
  customer                Customer?      @relation("ProposalCustomer", fields: [customerId], references: [id])
  customerName            String
  // Joint account (#12): the proposal's customer is the first holder; the second is an existing customer or a
  // new person (name + mobile) who becomes a customer when the policy is issued.
  jointAccount            Boolean        @default(false)
  secondHolderId          String?
  secondHolder            Customer?      @relation("ProposalSecondHolder", fields: [secondHolderId], references: [id])
  secondHolderName        String?
  secondHolderMobile      String?
  firstHolderCif          String? // CIF given by the post office / insurer to each holder (typed, like the policy number)
  secondHolderCif         String?
  mobile                  String
  insurer                 String
  productName             String
  sumInsured              Decimal?       @db.Decimal(14, 2)
  premium                 Decimal        @db.Decimal(12, 2) // what the customer pays (no GST)
  panMasked               String?
  aadhaarLast4            String?
  aadhaarEnc              String? // full values, encrypted; copied to the customer on issue
  panEnc                  String?
  aadhaarHash             String?
  panHash                 String?
  consentAt               DateTime? // #1 "Customer consent taken"
  consentById             String?
  policyNumber            String?
  status                  ProposalStatus @default(Draft)
  ownerId                 String
  createdAt               DateTime       @default(now())
  // Policy details entered on the proposal (or by "Add product directly"); copied to the policy when issued.
  productType             ProductType    @default(Insurance)
  productId               String?
  product                 Product?       @relation(fields: [productId], references: [id])
  schemeId                String?
  scheme                  Scheme?        @relation(fields: [schemeId], references: [id])
  frequency               Frequency?
  termMonths              Int?
  startDate               DateTime?      @db.Date
  premiumPayingTermMonths Int?
  nominee                 String?
  rateAtOpen              Decimal?       @db.Decimal(5, 2)
  customValues            Json? // { "<field label>": value }
  bankDetailsEnc          String? // AES-256-GCM, see src/lib/crypto.ts

  consents Consent[]
  calls    Call[]
  policy   Policy?

  @@unique([tenantId, proposalNo])
}

enum ConsentStatus {
  Sent
  Given
  Declined
  Expired
  Withdrawn
}

model Consent {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String?
  proposalId    String
  proposal      Proposal      @relation(fields: [proposalId], references: [id])
  mobile        String
  purpose       String
  textVersion   String
  status        ConsentStatus @default(Sent)
  otpVerifiedOn DateTime?
  ipAddress     String?
  expiresOn     DateTime
  createdAt     DateTime      @default(now())
}

// ───────────────────────── Customers and policies ─────────────────────────

model Customer {
  id           String    @id @default(cuid())
  tenantId     String
  cifNo        String    @default(dbgenerated("next_cif_no()")) // CIF-000124: one customer ID per person
  photoPath    String? // storage/photos/<id>.<ext>
  name         String
  mobile       String
  email        String?
  address      String?
  panMasked    String?
  aadhaarLast4 String?
  // Full Aadhaar / PAN (#13): AES-256-GCM encrypted; the keyed fingerprint (HMAC) makes each unique per agency.
  aadhaarEnc   String?
  panEnc       String?
  aadhaarHash  String?
  panHash      String?
  consentAt    DateTime? // #1 "Customer consent taken" (needed before Aadhaar / PAN are saved)
  consentById  String?
  ownerId      String
  createdAt    DateTime  @default(now())

  policies            Policy[]             @relation("PolicyCustomer")
  jointPolicies       Policy[]             @relation("PolicySecondHolder") // second holder of a joint account
  receipts            Receipt[]
  payments            Payment[]
  serviceTransactions ServiceTransaction[]
  ownerPaidSlips      OwnerPaidSlip[]
  quotations          Quotation[]
  proposals           Proposal[]           @relation("ProposalCustomer")
  jointProposals      Proposal[]           @relation("ProposalSecondHolder")
  mobiles             CustomerMobile[]
  directBills         DirectBill[]
  calls               Call[]

  @@unique([tenantId, cifNo])
  @@unique([tenantId, aadhaarHash])
  @@unique([tenantId, panHash])
  @@index([tenantId, mobile])
}

/**
 * Every mobile number of a customer (family members may share one, so not unique). `Customer.mobile` is the first.
 */
model CustomerMobile {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  number     String
  isWhatsApp Boolean  @default(false)
  sort       Int      @default(0)

  @@index([tenantId, number])
  @@index([customerId])
}

enum ProductType {
  Insurance
  MutualFund
  PoRd
  PoTd
  PoKvp
  PoNsc
  PoMis
  PoScss
  PoSsa
  PoPpf
}

enum Frequency {
  Monthly
  Quarterly
  HalfYearly
  Yearly
  OneTime
}

enum PolicyStatus {
  Active
  Lapsed
  Matured
  PrematureClosed // closed before maturity (date + reason); bills and reminders stop
  Withdrawn // mutual funds: withdraw date entered
}

model Policy {
  id                      String       @id @default(cuid())
  tenantId                String
  customerId              String
  customer                Customer     @relation("PolicyCustomer", fields: [customerId], references: [id])
  secondHolderId          String? // joint account: the second holder (bills and receipts stay with the first)
  secondHolder            Customer?    @relation("PolicySecondHolder", fields: [secondHolderId], references: [id])
  firstHolderCif          String? // CIFs given by the post office / insurer (from the proposal)
  secondHolderCif         String?
  proposalId              String?      @unique
  proposal                Proposal?    @relation(fields: [proposalId], references: [id])
  productType             ProductType
  partner                 String // insurer / AMC / "Post Office"
  productName             String
  policyNumber            String // policy, folio or PO account number
  premiumAmount           Decimal      @db.Decimal(12, 2) // premium, SIP or RD instalment
  frequency               Frequency
  startDate               DateTime     @db.Date
  termMonths              Int?
  sumAssured              Decimal?     @db.Decimal(14, 2)
  status                  PolicyStatus @default(Active)
  ownerId                 String
  createdAt               DateTime     @default(now())
  productId               String? // Settings → Products and schemes (null for policies made before the catalogue)
  product                 Product?     @relation(fields: [productId], references: [id])
  schemeId                String?
  scheme                  Scheme?      @relation(fields: [schemeId], references: [id])
  closedOn                DateTime?    @db.Date // premature closure or MF withdraw date
  closeReason             String?
  premiumPayingTermMonths Int?
  nominee                 String?
  rateAtOpen              Decimal?     @db.Decimal(5, 2) // scheme rate on the start date; later rate changes don't apply
  customValues            Json? // { "<field label>": value }
  bankDetailsEnc          String? // AES-256-GCM, see src/lib/crypto.ts

  calls          Call[]
  renewals       RenewalItem[]
  receipts       Receipt[]
  ownerPaidSlips OwnerPaidSlip[]
  commissions    Commission[]
  billGroup      BillGroupMember? // at most one bill group per policy

  @@unique([tenantId, policyNumber])
}

enum RenewalStatus {
  Due
  Overdue
  Paid
  Lapsed
  Stopped // policy closed early or withdrawn before this was paid
}

// ── Settings → Products and schemes ──

/**
 * When bills stop for a product (rule #13 of the Oct 2026 spec).
 */
enum InvoiceRule {
  UntilMaturity // RD: per pay mode, last bill the cycle before maturity
  UntilPremiumTerm // LIC, PLI, SBI Life, SSA, PPF: until the premium paying term ends
  UntilClosed // health: until withdrawn / closed
  None // TD, KVP, NSC, SCSS, MIS, mutual funds: no bills
}

enum CustomFieldType {
  Text
  Number
  Date
  Dropdown
}

model Product {
  id                  String      @id @default(cuid())
  tenantId            String
  name                String
  productType         ProductType // posting category and post office scheme
  partner             String // insurer / AMC / "Post Office"
  invoiceRule         InvoiceRule
  payModes            Frequency[]
  lockInMonths        Int?
  bankDetailsRequired Boolean     @default(false)
  bankFields          String[] // keys of BANK_FIELDS
  prematureClosure    Boolean     @default(true) // allowed (after lock-in)
  closeDuringLockIn   Boolean     @default(false) // may also be closed inside the lock-in period
  fields              String[] // keys of ACCOUNT_FIELDS shown on the policy
  requiredFields      String[]
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  schemes      Scheme[]
  customFields ProductCustomField[]
  policies     Policy[]
  proposals    Proposal[]

  @@unique([tenantId, partner, name])
}

model Scheme {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  name         String
  tenureMonths Int? // null = open-ended / renewable
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  rates        SchemeRate[]
  policies     Policy[]
  proposals    Proposal[]

  @@unique([productId, name])
}

/**
 * Interest rate history; a rate applies from `effectiveFrom` until the next one. Existing accounts keep their opening rate.
 */
model SchemeRate {
  id            String   @id @default(cuid())
  schemeId      String
  scheme        Scheme   @relation(fields: [schemeId], references: [id])
  rate          Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @db.Date
  changedById   String
  createdAt     DateTime @default(now())

  @@unique([schemeId, effectiveFrom])
}

model ProductCustomField {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  label     String
  type      CustomFieldType
  options   String[] // dropdown values
  required  Boolean         @default(false)
  sort      Int             @default(0)

  @@unique([productId, label])
}

/**
 * Change log: who changed what, when, old and new values.
 */
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  entity    String // "Product", "Scheme", "Policy", …
  entityId  String
  action    String // "Created", "Updated", "Rate changed", "Closed early", …
  summary   String
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model RenewalItem {
  id             String          @id @default(cuid())
  tenantId       String
  policyId       String
  policy         Policy          @relation(fields: [policyId], references: [id])
  dueDate        DateTime        @db.Date
  premiumAmount  Decimal         @db.Decimal(12, 2)
  status         RenewalStatus   @default(Due)
  paidReceiptId  String?
  paidReceipt    Receipt?        @relation(fields: [paidReceiptId], references: [id])
  paidOn         DateTime?       @db.Date
  lastReminderAt DateTime?
  reminderCount  Int             @default(0)
  billNo         String          @default(dbgenerated("next_bill_no()")) // BL-0001, given by the database
  ownerPaidSlips OwnerPaidSlip[]

  @@unique([tenantId, billNo])
  @@unique([policyId, dueDate]) // one bill per instalment date (advance bills can't be generated twice)
  @@index([tenantId, status, dueDate])
}

// ───────────────────────── Receipts and RD ─────────────────────────

enum PaymentMode {
  Cash
  UPI
  Cheque
  Bank
  Card
  NetBanking // customer's bank name + transaction ID
}

enum ReceiptStatus {
  Saved
  Cancelled
}

enum RdStatus {
  Collected
  Deposited
  Verified
}

model Receipt {
  id               String          @id @default(cuid())
  tenantId         String
  receiptNo        String
  fy               String // e.g. "2026-27"
  receiptDate      DateTime        @db.Date // bill date: drives Day Book, FY, paid-on, commission date
  txnDate          DateTime        @db.Date // when the customer actually paid (UPI/cheque date)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  policyId         String?
  policy           Policy?         @relation(fields: [policyId], references: [id])
  renewalItemId    String?
  amount           Decimal         @db.Decimal(12, 2)
  mode             PaymentMode
  accountId        String // account the money came into
  reference        String? // UTR / cheque no. / net banking transaction ID / card approval no.
  bankName         String? // net banking: the customer's bank (reference only)
  netType          String? // net banking: NEFT / IMPS / RTGS
  denominations    Json? // cash: { "500": 4, "200": 2, …, "coins": "12.50" }; on the Payment when several dues are paid together
  notes            String?
  isPassThrough    Boolean         @default(true)
  rdStatus         RdStatus? // RD instalments only
  ownerPaid        Boolean         @default(false) // closes owner-paid slips; never deposited to PO
  status           ReceiptStatus   @default(Saved)
  cancelReason     String?
  cancelledById    String?
  cancelledAt      DateTime?
  createdById      String
  createdAt        DateTime        @default(now())
  paymentId        String? // set when several dues were paid together
  payment          Payment?        @relation(fields: [paymentId], references: [id])
  companyPaymentId String? // set once the money is paid on to the insurer / AMC / post office (not RD: see PoDeposit)
  companyPayment   CompanyPayment? @relation(fields: [companyPaymentId], references: [id])

  poDepositLine PoDepositLine?
  closedSlips   OwnerPaidSlip[]
  commissions   Commission[]
  renewalItems  RenewalItem[]

  @@unique([tenantId, receiptNo, fy])
  @@index([tenantId, receiptDate])
}

enum PaymentKind {
  Customer // several dues of one customer
  Combined // bills ticked across customers, paid by one person
  BillGroup // a saved bill group ("Family grouped receipts")
}

/// One payment covering several dues: the payer gets one PAY- receipt, each due keeps its own RCPT line (under its own customer).
model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  paymentNo     String
  kind          PaymentKind   @default(Customer)
  receiptDate   DateTime      @db.Date // bill date, same on every line
  txnDate       DateTime      @db.Date
  customerId    String? // Customer kind only; combined and bill-group payments name the payer instead
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payerName     String? // "Paid by" on combined and bill-group receipts
  payerMobile   String?
  poReceiptNo   String? // optional PO receipt no. on a combined receipt
  billGroupId   String?
  billGroup     BillGroup?    @relation(fields: [billGroupId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  mode          PaymentMode
  reference     String?
  bankName      String?
  netType       String? // net banking: NEFT / IMPS / RTGS
  denominations Json?
  notes         String?
  status        ReceiptStatus @default(Saved)
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())

  receipts Receipt[]

  @@unique([tenantId, paymentNo])
}

enum OwnerPaidSlipStatus {
  CustomerOwes
  CollectedReturnToOwner
  Settled
  Cancelled
}

model OwnerPaidSlip {
  id                String              @id @default(cuid())
  tenantId          String
  slipNo            String
  policyId          String
  policy            Policy              @relation(fields: [policyId], references: [id])
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id])
  renewalItemId     String?
  renewalItem       RenewalItem?        @relation(fields: [renewalItemId], references: [id])
  month             DateTime            @db.Date
  amount            Decimal             @db.Decimal(12, 2)
  poReceiptNo       String // reference no.: PO receipt no. for RD, insurer receipt / transaction no. otherwise
  status            OwnerPaidSlipStatus @default(CustomerOwes)
  closedByReceiptId String?
  closedByReceipt   Receipt?            @relation(fields: [closedByReceiptId], references: [id])
  returnedEntryId   String?
  confirmedById     String?
  confirmedOn       DateTime?
  createdById       String
  createdAt         DateTime            @default(now())

  @@unique([tenantId, slipNo])
}

/// Collected premiums paid on to one company (insurer, AMC or post office for SSA/PPF) in one go.
model CompanyPayment {
  id           String       @id @default(cuid())
  tenantId     String
  company      String // Policy.partner of every receipt in it
  paidOn       DateTime     @db.Date
  accountId    String // account the money left
  mode         PaymentMode
  amount       Decimal      @db.Decimal(12, 2)
  reference    String // company receipt / UTR / cheque no.
  createdById  String
  createdAt    DateTime     @default(now())
  // Post office payments (SSA, PPF, TD…) are checked on the agent portal by policy number.
  verifyStatus VerifyStatus @default(Pending)
  verifyNote   String?
  verifiedById String?
  verifiedAt   DateTime?

  receipts Receipt[]
}

/// Checked on the post office agent portal: RD deposits by PO receipt no., other schemes by policy no.
enum VerifyStatus {
  Pending
  Verified
  Mismatch
}

model PoDeposit {
  id               String       @id @default(cuid())
  tenantId         String
  poReceiptNo      String
  depositDate      DateTime     @db.Date
  amount           Decimal      @db.Decimal(12, 2)
  receiptsTotal    Decimal      @db.Decimal(12, 2)
  upiPortion       Decimal      @db.Decimal(12, 2)
  adjustmentReason String?
  adjustmentNote   String?
  createdById      String
  createdAt        DateTime     @default(now())
  verifyStatus     VerifyStatus @default(Pending)
  verifyNote       String?
  verifiedById     String?
  verifiedAt       DateTime?

  lines       PoDepositLine[]
  commissions Commission[]
}

model PoDepositLine {
  id          String    @id @default(cuid())
  poDepositId String
  poDeposit   PoDeposit @relation(fields: [poDepositId], references: [id])
  receiptId   String    @unique
  receipt     Receipt   @relation(fields: [receiptId], references: [id])
  policyId    String
  amount      Decimal   @db.Decimal(12, 2)
}

enum CommissionSourceType {
  RdReceipt
  Challan
  Partner
}

enum CommissionStatus {
  Expected
  Received
  Cancelled
}

model Commission {
  id          String               @id @default(cuid())
  tenantId    String
  sourceType  CommissionSourceType
  sourceNo    String // receipt no., challan no. or partner statement ref
  policyId    String?
  policy      Policy?              @relation(fields: [policyId], references: [id])
  receiptId   String?
  receipt     Receipt?             @relation(fields: [receiptId], references: [id])
  poDepositId String?
  poDeposit   PoDeposit?           @relation(fields: [poDepositId], references: [id])
  earnedOn    DateTime             @db.Date
  baseAmount  Decimal              @db.Decimal(14, 2)
  rate        Decimal              @db.Decimal(6, 4) // 0.0040 = 0.4%
  gross       Decimal              @db.Decimal(12, 2)
  tdsRate     Decimal              @db.Decimal(6, 4)
  tds         Decimal              @db.Decimal(12, 2)
  net         Decimal              @db.Decimal(12, 2)
  status      CommissionStatus     @default(Expected)
  receivedOn  DateTime?            @db.Date

  @@index([tenantId, earnedOn])
}

// ───────────────────────── E-Sevai ─────────────────────────

model ServiceType {
  id              String  @id @default(cuid())
  tenantId        String
  code            String // EB, PAN, CERT
  name            String
  walletAccountId String
  allowBankPay    Boolean @default(false)

  rates        ServiceRate[]
  transactions ServiceTransaction[]

  @@unique([tenantId, code])
}

model ServiceRate {
  id                  String      @id @default(cuid())
  serviceTypeId       String
  serviceType         ServiceType @relation(fields: [serviceTypeId], references: [id])
  minAmount           Decimal?    @db.Decimal(12, 2) // inclusive; slab rates only
  maxAmount           Decimal?    @db.Decimal(12, 2) // inclusive
  serviceCharge       Decimal?    @db.Decimal(12, 2) // slab: added to bill amount
  walletCost          Decimal?    @db.Decimal(12, 2) // fixed: provider cost
  fixedCustomerAmount Decimal?    @db.Decimal(12, 2) // fixed: customer pays
  effectiveFrom       DateTime    @db.Date
}

/// How the provider was paid for an E-Sevai service (change set #7).
enum ServicePaidVia {
  Wallet // CSC / E-Sevai / other wallet
  GPay // GPay direct from a bank account
  NetBanking // net banking direct from a bank account
}

enum ServiceTxnStatus {
  Saved
  Cancelled
}

model ServiceTransaction {
  id                String           @id @default(cuid())
  tenantId          String
  txnNo             String
  txnDate           DateTime         @db.Date
  txnTime           String? // "14:05" (IST) as entered; older entries use createdAt
  serviceTypeId     String
  serviceType       ServiceType      @relation(fields: [serviceTypeId], references: [id])
  customerName      String?
  customerMobile    String?
  paidFromAccountId String // wallet or bank
  receivedAccountId String // cash or bank (customer payment)
  baseAmount        Decimal          @db.Decimal(12, 2)
  serviceCharge     Decimal          @db.Decimal(12, 2)
  walletCost        Decimal          @db.Decimal(12, 2)
  customerAmount    Decimal          @db.Decimal(12, 2)
  profit            Decimal          @db.Decimal(12, 2)
  providerRef       String? // service no. / application no. (EB consumer no.)
  providerTxnNo     String? // provider / wallet transaction number (optional)
  serviceName       String? // "Other" services: the name typed
  customerId        String? // linked when the mobile belongs to a customer
  customer          Customer?        @relation(fields: [customerId], references: [id])
  gender            Gender?
  paidVia           ServicePaidVia   @default(Wallet)
  denominations     Json? // cash notes / coins collected
  notes             String?
  paymentMode       PaymentMode
  reference         String? // UTR when paid by UPI / bank
  status            ServiceTxnStatus @default(Saved)
  createdById       String
  createdAt         DateTime         @default(now())

  @@unique([tenantId, txnNo])
}

// ───────────────────────── Money accounts and Day Book ─────────────────────────

enum AccountType {
  Cash
  Bank
  Wallet
}

enum BankAccountKind {
  Savings
  Current
}

enum WalletKind {
  CSC
  ESevai
  Other
}

model Account {
  id                  String           @id @default(cuid())
  tenantId            String
  type                AccountType
  name                String
  last4               String?
  openingBalance      Decimal          @db.Decimal(14, 2)
  openingDate         DateTime         @db.Date // balance is as at start of this date
  lowBalanceThreshold Decimal?         @db.Decimal(12, 2)
  active              Boolean          @default(true) // inactive: hidden from new entries, still shown on old ones
  isDefault           Boolean          @default(false) // the bank account used until a screen lets staff pick one
  // Bank details (Settings → Bank accounts and wallets); the account number is AES-GCM encrypted.
  bankName            String?
  branch              String?
  accountNoEnc        String?
  ifsc                String?
  micr                String?
  accountKind         BankAccountKind?
  walletKind          WalletKind? // null for the older EB / PAN / certificate wallets

  entries            DayBookEntry[]
  dayCloses          DayClose[]
  ownerEntries       OwnerEntry[]
  commissionReceipts CommissionReceipt[]
}

enum ExpenseStatus {
  Saved // within auto-approve limit
  Waiting
  Approved
  Rejected
  Cancelled
}

enum ApprovalLevel {
  None
  Admin
  SuperAdmin
}

enum PaidBy {
  Company
  Employee
  Owner
}

enum RepaymentStatus {
  NotNeeded
  ToBeRepaid
  Repaid
}

model Vendor {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  expenses Expense[]

  @@unique([tenantId, name])
}

model Expense {
  id                  String          @id @default(cuid())
  tenantId            String
  expenseNo           String
  expenseDate         DateTime        @db.Date
  category            String
  description         String
  notes               String? // required on new expenses (older ones have none)
  denominations       Json? // cash notes/coins when paid from office cash (copied to the Day Book line when paid)
  amount              Decimal         @db.Decimal(12, 2)
  vendorId            String
  vendor              Vendor          @relation(fields: [vendorId], references: [id])
  billNo              String
  billPhotoPath       String?
  paidBy              PaidBy          @default(Company)
  paidByName          String?
  mode                PaymentMode
  fromAccountId       String? // company account when paidBy = Company
  repaymentStatus     RepaymentStatus @default(NotNeeded)
  repaidOn            DateTime?       @db.Date
  repaidFromAccountId String?
  status              ExpenseStatus
  approvalLevel       ApprovalLevel   @default(None)
  approvedById        String?
  approvedAt          DateTime?
  rejectReason        String?
  cancelReason        String?
  createdById         String
  createdAt           DateTime        @default(now())

  @@unique([tenantId, expenseNo])
  @@unique([tenantId, vendorId, billNo])
}

enum Direction {
  In
  Out
}

enum EntryType {
  Collection // customer receipt
  ServiceCollection // E-Sevai customer payment
  ServiceCost // E-Sevai provider cost (wallet/bank out)
  WalletRecharge
  Expense
  ExpenseRepayment
  Withdrawal // ATM / bank → cash (contra)
  DepositToBank // cash → bank (contra)
  DepositToPo
  PaidToCompany
  OwnerReturn
  Adjustment
  OtherIncome // income entered in the Day Book (interest, incentives…); counted in P&L
  OwnerWithdrawal // owner takes money out for personal use: not an expense, not in P&L
  OwnerContribution // owner puts money in: not income, never repaid
}

enum SourceType {
  Receipt
  DirectBill
  ServiceTransaction
  Expense
  PoDeposit
  CompanyPayment
  OwnerPaidSlip
  Contra
  WalletRecharge
  Manual
  OwnerEntry
}

model DayBookEntry {
  id              String        @id @default(cuid())
  tenantId        String
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  entryDate       DateTime      @db.Date
  direction       Direction
  amount          Decimal       @db.Decimal(12, 2)
  entryType       EntryType
  mode            PaymentMode?
  isPassThrough   Boolean       @default(false)
  sourceType      SourceType
  sourceId        String?
  sourceNo        String? // RCPT-0891, EXP-0142, PO receipt no.
  particulars     String
  denominations   Json? // cash notes/coins counted for a cash line
  productCategory String?
  scheme          String?
  notes           String?
  reversalOfId    String?       @unique
  reversalOf      DayBookEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy      DayBookEntry? @relation("Reversal")
  idempotencyKey  String        @unique
  createdById     String
  createdAt       DateTime      @default(now())

  @@index([tenantId, entryDate])
  @@index([accountId, entryDate])
  @@index([sourceType, sourceId])
}

enum DayCloseStatus {
  Open // verification saved, not closed
  Closed
}

model DayClose {
  id           String         @id @default(cuid())
  tenantId     String
  accountId    String
  account      Account        @relation(fields: [accountId], references: [id])
  date         DateTime       @db.Date
  opening      Decimal        @db.Decimal(14, 2)
  totalIn      Decimal        @db.Decimal(14, 2)
  totalOut     Decimal        @db.Decimal(14, 2)
  computed     Decimal        @db.Decimal(14, 2)
  physical     Decimal?       @db.Decimal(14, 2)
  difference   Decimal?       @db.Decimal(14, 2)
  cashBySource Json? // cash account only: { PostOffice, GRM, ESevai, PAN, Others }
  status       DayCloseStatus @default(Open)
  verifiedById String?
  verifiedAt   DateTime?
  closedById   String?
  closedAt     DateTime?

  @@unique([tenantId, accountId, date])
}

// ───────────────────────── Messages (mocked) ─────────────────────────

enum MessageChannel {
  WhatsApp
  SMS
  Email
}

model MessageLog {
  id          String         @id @default(cuid())
  tenantId    String
  channel     MessageChannel
  to          String
  template    String
  body        String
  relatedType String?
  relatedId   String?
  status      String         @default("Sent (mock)")
  createdById String?
  createdAt   DateTime       @default(now())
}

// ── Attachments ──

enum AttachmentOwner {
  Quotation
  Proposal
  Customer
}

/**
 * A file on a quotation, proposal or customer (files live in storage/attachments, served by /api/attachments/[id]).
 */
model Attachment {
  id           String          @id @default(cuid())
  tenantId     String
  ownerType    AttachmentOwner
  ownerId      String
  kind         String // "Aadhaar", "PAN", "Photo", "Health declaration", "Other", …
  fileName     String // as uploaded
  storedName   String
  contentType  String
  size         Int
  uploadedById String
  createdAt    DateTime        @default(now())

  @@index([ownerType, ownerId])
}

/// Payment modes that can be switched off and the bank names offered for net banking (Settings → Payment modes).
model PaymentOption {
  id       String        @id @default(cuid())
  tenantId String
  kind     PayOptionKind
  name     String // a PaymentMode value for kind Mode; a bank name for kind Bank
  active   Boolean       @default(true)
  sort     Int           @default(0)

  @@unique([tenantId, kind, name])
}

enum PayOptionKind {
  Mode
  Bank
}

/// A bill for anyone (customer or not: name + mobile) for a purpose; money in through the Day Book like a receipt.
model DirectBill {
  id            String        @id @default(cuid())
  tenantId      String
  billNo        String // DB-0001
  billDate      DateTime      @db.Date
  customerId    String? // linked when the mobile belongs to a customer
  customer      Customer?     @relation(fields: [customerId], references: [id])
  payerName     String
  payerMobile   String
  purpose       String
  amount        Decimal       @db.Decimal(12, 2)
  mode          PaymentMode
  accountId     String
  reference     String?
  bankName      String?
  netType       String? // net banking: NEFT / IMPS / RTGS
  denominations Json?
  status        ReceiptStatus @default(Saved)
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?
  createdById   String // received by
  createdAt     DateTime      @default(now())

  @@unique([tenantId, billNo])
  @@index([tenantId, payerMobile])
}

/// Values of a dropdown kept in Settings (expense purposes now; "Other" values typed by staff later).
/// Removing a value hides it from new entries; old records keep the text.
model DropdownOption {
  id           String   @id @default(cuid())
  tenantId     String
  list         String // "expensePurpose", …
  value        String
  active       Boolean  @default(true)
  addedByStaff Boolean  @default(false)
  sort         Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([tenantId, list])
}

/// Bill groups (change set #21): saved sets of policies / accounts across customers, billed and paid as one.
/// Created and edited by Admin / Super Admin only.
model BillGroup {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  contactName   String? // offered as "Paid by" on the group's receipts
  contactMobile String?
  createdById   String
  createdAt     DateTime          @default(now())
  members       BillGroupMember[]
  payments      Payment[]

  @@unique([tenantId, name])
}

model BillGroupMember {
  id          String    @id @default(cuid())
  billGroupId String
  billGroup   BillGroup @relation(fields: [billGroupId], references: [id], onDelete: Cascade)
  policyId    String    @unique // one group per policy, so a bill can't be billed through two groups
  policy      Policy    @relation(fields: [policyId], references: [id])
  addedById   String
  addedAt     DateTime  @default(now())
}

// ── Owner money (change set #19, #20): withdrawals and contributions, confirmed by the owner ──

enum OwnerEntryKind {
  Withdrawal
  Contribution
}

enum OwnerEntryStatus {
  Pending // recorded, waiting for the Super Admin
  Confirmed
  Rejected // reversed in the Day Book on the day it was rejected
}

/// Posted to the Day Book when recorded (the money really moved); the Super Admin confirms or rejects it.
/// Never part of P&L; listed in the P&L "Owner statement".
model OwnerEntry {
  id            String           @id @default(cuid())
  tenantId      String
  kind          OwnerEntryKind
  entryDate     DateTime         @db.Date
  accountId     String // office cash or a bank account
  account       Account          @relation(fields: [accountId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  reference     String? // bank transaction no. (required for bank)
  reason        String
  denominations Json? // cash notes / coins
  status        OwnerEntryStatus @default(Pending)
  decidedById   String?
  decidedAt     DateTime?
  rejectReason  String?
  createdById   String
  createdAt     DateTime         @default(now())

  @@index([tenantId, entryDate])
}

// ── Commission received (change set #18): Super Admin only ──

enum CommissionReceiptStatus {
  Saved
  Cancelled
}

/// Commission money received from an insurer, the post office or an AMC. Owner-only ledger: never in the Day Book,
/// so the bank balances and tallies Admins see leave it out (owner, 22 Oct 2026). Counted in P&L for `forMonth`.
model CommissionReceipt {
  id            String                  @id @default(cuid())
  tenantId      String
  source        String // LIC, Post Office, … or a typed name
  forMonth      String // "2026-09": the month the commission is for
  amount        Decimal                 @db.Decimal(12, 2)
  accountId     String // bank account it was received into
  account       Account                 @relation(fields: [accountId], references: [id])
  reference     String // UTR / transaction no.
  receivedOn    DateTime                @db.Date
  note          String?
  status        CommissionReceiptStatus @default(Saved)
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime                @default(now())

  @@index([tenantId, forMonth])
}

/// Settings → Roles and access (Super Admin): a permission given to or taken from a role, where it differs from the
/// built-in default (src/lib/permissions.ts). The Super Admin always has everything.
model RolePermission {
  id          String   @id @default(cuid())
  tenantId    String
  role        Role
  permission  String
  allowed     Boolean
  updatedById String
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, role, permission])
}
