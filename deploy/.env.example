# Copy to .env next to docker-compose.yml.
# A long random string, different for every installation (never reuse the developer's).
BETTER_AUTH_SECRET="change-me"
# The address people type in the browser. Use the PC's LAN IP if other PCs will open it.
BETTER_AUTH_URL="http://localhost:3000"
# REQUIRED. Encrypts Aadhaar, PAN and bank details; they can't be saved while this is "change-me". Never change it once
# real data is saved. 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="change-me"

# demo = load the demo agency (logins use password demo1234). live = real business: no demo data,
# one owner login from the SETUP_ values below, and the demo seed is refused. Keep "live" for good.
INSTALL_MODE="demo"
# Live only, read once on the first start. Remove SETUP_OWNER_PASSWORD from this file afterwards.
# Put the password in single quotes: inside double quotes a $ is cut off.
SETUP_OWNER_NAME=""
SETUP_OWNER_USERNAME=""
SETUP_OWNER_PASSWORD=''
# Live only: cash in the office and E-Sevai wallet balance on the first day (rupees, e.g. 12000.50).
SETUP_CASH_OPENING="0"
SETUP_WALLET_OPENING="0"
# Database password: letters and digits only. Set it before the first start and never change it.
POSTGRES_PASSWORD="flcrm"
